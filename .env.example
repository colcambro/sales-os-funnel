# Copy this file to .env for local development (vite dev / netlify dev), and
# set the real values in the Netlify dashboard (Site settings → Environment
# variables) for production/deploy previews. Never commit a real .env file —
# it's already excluded via .gitignore.

# Required. Stripe secret key — used server-side only, in
# netlify/functions/get-checkout-session.js, to look up a completed Checkout
# Session (read-only) so the /thank-you page can confirm the sale and fire
# an accurate Meta Pixel Purchase event. Checkout itself doesn't need this
# key: src/routes/checkout.tsx links straight to Stripe's own hosted Payment
# Links, which create the session on Stripe's side automatically.
# Use a sk_test_... key while testing, sk_live_... only once ready to go live.
STRIPE_SECRET_KEY=
